STRIPE_WEBHOOK_SECRET=whsec_placeholder

# Publishable key for frontend (optional, for client-side Stripe integration)
STRIPE_PUBLISHABLE_KEY=pk_test_51TJ5QkFl186WvkEpt42GzFWAsB2lmmHykcjehYIIzMhuk5c9LvTK1Gphis+HwhGB12rrHn6Eh1TdP5G0LhQ8uU00GcUas1l

# The recurring monthly price ID for the Pro plan (LEGACY $9.99/mo for existing users)
# dashboard.stripe.com/products → create product → copy Price ID
STRIPE_PRO_PRICE_ID=price_placeholder

# NEW: The price ID for recruiting lead unlocks ($5 per candidate)
# Create in Stripe dashboard: Products → New Product → "Lead Unlock" → $5.00 → copy Price ID
STRIPE_LEAD_UNLOCK_PRICE_ID=price_1TJSyQFLlI86WvkE7TfA9vdN

# NEW 3-TIER PRICING: Create these in Stripe Dashboard → Products → New Product
# 1. Pro Monthly ($19/month, recurring)
STRIPE_PRO_MONTHLY_NEW_PRICE_ID=price_xxx_REPLACE_WITH_STRIPE_ID

# 2. Pro Gateway ($49 one-time, then auto-upgrades to $19/mo after trial)
STRIPE_GATEWAY_ONE_TIME_PRICE_ID=price_yyy_REPLACE_WITH_STRIPE_ID

# 3. Agency Monthly ($99/month, 50 scans/month)
STRIPE_AGENCY_MONTHLY_PRICE_ID=price_zzz_REPLACE_WITH_STRIPE_ID

# Success and cancel URLs for Stripe checkout
STRIPE_SUCCESS_URL=http://localhost:5173/dashboard?upgrade=success
STRIPE_CANCEL_URL=http://localhost:5173/pricing?canceled=true

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
# Absolute path where matplotlib chart PNGs are stored (per-session subdirs)
CHARTS_DIR=backend/charts

# CORS — comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
