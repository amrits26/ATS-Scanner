# =============================================================================
# IntelliResume AI — Environment Variables Template
# Copy this file to .env and fill in your values.
# NEVER commit .env to source control.
# =============================================================================

# ---------------------------------------------------------------------------
# Database (PostgreSQL via Supabase or self-hosted)
# ---------------------------------------------------------------------------
# Supabase: Settings → Database → Connection String → URI (use "Transaction" mode
# for serverless, or "Session" mode for a persistent server process)
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/intelliresume_ai

# ---------------------------------------------------------------------------
# Supabase Auth
# ---------------------------------------------------------------------------
# Found at: app.supabase.com → Project Settings → API
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_ANON_KEY=your-anon-key-here

# JWT secret — used to verify tokens server-side without a network call.
# Found at: Project Settings → API → JWT Settings → JWT Secret
SUPABASE_JWT_SECRET=dev-test-secret-local-only-not-production

# ---------------------------------------------------------------------------
# Google Gemini
# ---------------------------------------------------------------------------
# Get at: aistudio.google.com/app/apikey
GOOGLE_API_KEY=AIzaSyA8DKQ3ZaVMQ_9RhgO_eecO3r6zDXI14fc

# ---------------------------------------------------------------------------
# Stripe  (scaffold — fill in when Stripe account is ready)
# ---------------------------------------------------------------------------
# Found at: dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_51TJ5QkFl186WvkEfOXbeNETE3p7ni0Wh15bjdXmgfsmoR8hPHKaPteIz1RboMvZ5Zq21fVUv4M9E6mgL0DbptDq00MDlUx1BA

