# Frontend Environment Variables
# Copy this file to .env.local and fill in your own values

# Supabase Configuration
# Get these from: https://supabase.com/dashboard → Settings → API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# API Base (leave empty for same-origin, or set to backend URL)
VITE_API_BASE=

# Optional: Enable Demo/Guest Mode
VITE_ENABLE_DEMO_MODE=false
