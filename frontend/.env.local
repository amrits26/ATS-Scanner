# Frontend Environment Variables
# Update these with your actual Supabase credentials to enable real authentication

# Supabase Configuration (get from: https://supabase.com/dashboard → Settings → API)
VITE_SUPABASE_URL=https://placeholder.supabase.co
VITE_SUPABASE_ANON_KEY=placeholder-key-less-than-20-chars

# API Base (points to backend)
VITE_API_BASE=http://localhost:8000
