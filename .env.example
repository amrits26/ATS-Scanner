# =============================================================================
# IntelliResume AI — Environment Variables Template
# Copy this file to .env and fill in your values.
# NEVER commit .env to source control.
# =============================================================================

# ---------------------------------------------------------------------------
# Database (PostgreSQL via Supabase or self-hosted)
# ---------------------------------------------------------------------------
# Supabase: Settings → Database → Connection String → URI (use "Transaction" mode
# for serverless, or "Session" mode for a persistent server process)
DATABASE_URL=postgresql+asyncpg://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# ---------------------------------------------------------------------------
# Supabase Auth
# ---------------------------------------------------------------------------
# Found at: app.supabase.com → Project Settings → API
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_ANON_KEY=your-anon-key-here

# JWT secret — used to verify tokens server-side without a network call.
# Found at: Project Settings → API → JWT Settings → JWT Secret
SUPABASE_JWT_SECRET=your-jwt-secret-here

# ---------------------------------------------------------------------------
# Google Gemini
# ---------------------------------------------------------------------------
# Get at: aistudio.google.com/app/apikey
GOOGLE_API_KEY=your-gemini-api-key-here

# ---------------------------------------------------------------------------
# Stripe  (scaffold — fill in when Stripe account is ready)
# ---------------------------------------------------------------------------
# Found at: dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_placeholder

# Webhook secret — generated when you register the webhook endpoint in Stripe dashboard
# dashboard.stripe.com/webhooks → endpoint: https://your-domain.com/api/webhooks/stripe
STRIPE_WEBHOOK_SECRET=whsec_placeholder

# The recurring monthly price ID for the Pro plan
# dashboard.stripe.com/products → create product → copy Price ID
STRIPE_PRO_PRICE_ID=price_placeholder

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
# Absolute path where matplotlib chart PNGs are stored (per-session subdirs)
CHARTS_DIR=backend/charts

# CORS — comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------------------------------------------------------------------------
# PHASE 1: EMAIL AUTOMATION
# ---------------------------------------------------------------------------
# Resend Email Service (https://resend.com)
RESEND_API_KEY=re_your_api_key_here
RESEND_FROM_EMAIL=noreply@intelliresume.ai
RESEND_WEBHOOK_SECRET=secret_your_webhook_secret_here

# Email template IDs (create in Resend dashboard)
RESEND_TEMPLATE_FEAR_EMAIL=fear-email-24h-v1
RESEND_TEMPLATE_ABANDONED=abandoned-scan-72h-v1
RESEND_TEMPLATE_DIGEST=weekly-digest-v1

# ---------------------------------------------------------------------------
# PHASE 2: AI AGENTS
# ---------------------------------------------------------------------------
# Agent settings
AGENT_COST_MONTHLY_LIMIT_CENTS=10000  # $100/month max spend on Gemini
AGENT_MAX_EXECUTION_TIME_SECONDS=60  # Timeout for agent runs

# Job scraper settings
JOB_SCRAPER_USER_AGENT="IntelliResume AI Job Scraper v1.0"
JOB_SCRAPER_TIMEOUT_SECONDS=10

# Coach agent pricing
COACH_MAX_FREE_SESSIONS=1  # Free tier gets 1 session/month
COACH_MAX_PRO_SESSIONS=5  # Pro tier gets 5 sessions/month
COACH_PRICE_MONTHLY_CENTS=999  # $9.99/month add-on

