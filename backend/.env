# =============================================================================
# IntelliResume AI — Backend Configuration (Local Development)
# =============================================================================

# ---------------------------------------------------------------------------
# Database: Local PostgreSQL (via pgAdmin 4)
# ---------------------------------------------------------------------------
# Format: postgresql+asyncpg://[USER]:[PASSWORD]@[HOST]:[PORT]/[DATABASE]
# Change PASSWORD to your PostgreSQL password (set during installation)
# Change DATABASE name if you created a different one
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/intelliresume_ai

# ---------------------------------------------------------------------------
# Supabase Auth (For demo mode bypass - optional)
# ---------------------------------------------------------------------------
# Demo mode uses hardcoded user - these are not required for local testing
SUPABASE_URL=https://placeholder.supabase.co
SUPABASE_ANON_KEY=placeholder-anon-key
SUPABASE_JWT_SECRET=placeholder-jwt-secret

# ---------------------------------------------------------------------------
# Google Gemini (LLM Analysis)
# ---------------------------------------------------------------------------
GOOGLE_API_KEY=AIzaSyA8DKQ3ZaVMQ_9RhgO_eecO3r6zDXI14fc

# ---------------------------------------------------------------------------
# Stripe (Premium Features - Optional)
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder
STRIPE_PRO_PRICE_ID=price_placeholder

# ---------------------------------------------------------------------------
# CORS Configuration (Allowed Frontend Origins)
# ---------------------------------------------------------------------------
# Add all frontend dev server ports (separated by commas)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://127.0.0.1:5173,http://127.0.0.1:5174,http://127.0.0.1:5175

# ---------------------------------------------------------------------------
# Pro Testing Mode (Founder/Admin Bypass)
# ---------------------------------------------------------------------------
# Email addresses that automatically get PRO tier for testing
ADMIN_EMAIL=demo@intelliresume.ai

# ---------------------------------------------------------------------------
# Chart Storage
# ---------------------------------------------------------------------------
CHARTS_DIR=backend/charts
