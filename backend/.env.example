# ============================================================================
# IntelliResume AI Backend - Environment Configuration Template
# ============================================================================
# Copy this to .env and fill in actual values before running.
# NEVER commit .env to version control - it contains secrets!
# ============================================================================

# ---------------------------------------------------------------------------
# Database (PostgreSQL)
# ---------------------------------------------------------------------------
# Format: postgresql+asyncpg://[USER]:[PASSWORD]@[HOST]:[PORT]/[DATABASE]
# For local development:
#   DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/intelliresume_ai
# For Supabase Cloud:
#   DATABASE_URL=postgresql+asyncpg://postgres.[project-id]:[password]@db.[project-id].supabase.co:5432/postgres
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/intelliresume_ai

# ---------------------------------------------------------------------------
# AI/LLM API Keys
# ---------------------------------------------------------------------------
# Google Generative AI (Gemini API)
# Get from: https://console.cloud.google.com → Create project → Enable Generative AI API
# Generate API key: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your-gemini-api-key-here

# OpenAI (optional, backup provider)
# Get from: https://platform.openai.com/api-keys
# Only required if using OpenAI as fallback (currently not used)
OPENAI_API_KEY=your-openai-api-key-here

# ---------------------------------------------------------------------------
# Supabase Auth (for JWT verification & user auth)
# ---------------------------------------------------------------------------
# Get from: https://supabase.com → Project Settings
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# ---------------------------------------------------------------------------
# Stripe Payment Processing
# ---------------------------------------------------------------------------
# Get from: https://dashboard.stripe.com → Settings → API Keys

# Production API Key (sk_live_*) or Test Key (sk_test_*)
# IMPORTANT: Use sk_test_* for development, sk_live_* for production
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key-here

# Webhook endpoint secret
# Get from: https://dashboard.stripe.com → Webhooks → [Select endpoint] → Signing secret
# After deploying, create endpoint: POST https://api.yourdomain.com/api/payments/webhook
# Events: checkout.session.completed, customer.subscription.deleted, invoice.payment_failed
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret-here

# Product/Price ID for Pro subscription ($19/month)
# Get from: https://dashboard.stripe.com → Products → IntelliResume Pro
# Create subscription product with monthly billing
STRIPE_PRO_PRICE_ID=price_your-pro-price-id-here

# Success and cancel URLs (where users are redirected after Stripe checkout)
# IMPORTANT: Must match your production domain
# Local development:
#   STRIPE_SUCCESS_URL=http://localhost:5173/success
#   STRIPE_CANCEL_URL=http://localhost:5173/upgrade?canceled=true
# Production:
#   STRIPE_SUCCESS_URL=https://app.intelliresume.ai/success
#   STRIPE_CANCEL_URL=https://app.intelliresume.ai/upgrade?canceled=true
STRIPE_SUCCESS_URL=http://localhost:5173/success
STRIPE_CANCEL_URL=http://localhost:5173/upgrade?canceled=true

# ---------------------------------------------------------------------------
# CORS & Allowed Origins
# ---------------------------------------------------------------------------
# Comma-separated list of domains allowed to make API requests
# Local development:
#   ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Production with custom domain:
#   ALLOWED_ORIGINS=https://app.intelliresume.ai,https://www.intelliresume.ai
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------------------------------------------------------------------------
# Optional: Advanced Features
# ---------------------------------------------------------------------------

# Chart storage directory
# Default: backend/charts
# Set to absolute path for production: /var/data/intelliresume/charts
CHARTS_DIR=backend/charts

# Admin email for auto-upgrade to Pro tier (for testing/development)
# Users with this email automatically get Pro tier on first login
# Example: ADMIN_EMAIL=founder@intelliresume.ai
ADMIN_EMAIL=demo@intelliresume.ai

# ---------------------------------------------------------------------------
# IMPORTANT: Before Deployment
# ---------------------------------------------------------------------------
# 1. Generate a new Gemini API key (revoke the old one)
# 2. Request Stripe production mode access (usually 24 hours)
# 3. Create webhook endpoint in Stripe Dashboard
# 4. Update STRIPE_SUCCESS_URL and STRIPE_CANCEL_URL to production domain
# 5. Set ALLOWED_ORIGINS to production domain
# 6. Verify DATABASE_URL points to Supabase cloud (not localhost)
# 7. Never commit this file to version control
# 8. Use Railway/Render environment variables or secure vault (e.g., GitHub Secrets)
